# ---------------------------------------------------------------------------
# Remote Support MVP — example environment.
# Copy to `.env` (git-ignored) and fill in real values for local dev.
# NEVER commit a real .env. All secrets are supplied via env vars only.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=remote
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=remote_support
# DSN the backend uses. Host `postgres` is the compose service name.
# NOTE: the password here MUST match POSTGRES_PASSWORD above. If you change one,
# change both — otherwise the backend starts but fails Postgres auth. (Under
# docker-compose you can instead delete this line to let compose derive the DSN
# from POSTGRES_PASSWORD automatically.)
DATABASE_URL=postgres://remote:change-me-postgres@postgres:5432/remote_support?sslmode=disable

# --- Redis / Valkey (presence + session-code cache) ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
# APP_ENV: "dev" relaxes the strict secret checks so the "change-me" placeholders
# below boot locally. Leave it UNSET (or set to anything other than "dev") in
# production — the backend then refuses to start with any placeholder secret.
APP_ENV=dev
# Bind address for the Go API + signaling server.
BACKEND_HTTP_ADDR=:8080
# Secret used to sign technician JWTs (HS256). Must be >= 32 bytes. Rotate per deploy.
JWT_SECRET=change-me-to-a-long-random-32-byte-minimum-secret
# Access-token lifetime.
JWT_TTL=3600s
# Shared enrollment token an operator gives an agent to register a new
# unattended device. Single value for MVP; per-tenant tokens are post-MVP.
AGENT_ENROLLMENT_TOKEN=change-me-enrollment-token
# Attended session-code settings.
SESSION_CODE_TTL=300s
SESSION_CODE_LENGTH=9
# CORS: origin of the web console (browser).
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Seed technician created on first boot if the technicians table is empty.
# Leave blank to disable auto-seeding.
SEED_TECH_EMAIL=admin@example.com
SEED_TECH_PASSWORD=change-me-admin-password

# --- Web console (Next.js, browser-exposed vars are NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080

# --- TURN / STUN (coturn) ---
# Static credentials for the MVP. Production should use short-lived
# TURN REST credentials; see docs/SECURITY_MODEL.md.
TURN_REALM=remote.local
TURN_USER=turnuser
TURN_PASSWORD=change-me-turn-password
# ICE server list the backend hands to peers (JSON array of URLs).
ICE_SERVERS=["stun:coturn:3478","turn:coturn:3478"]
