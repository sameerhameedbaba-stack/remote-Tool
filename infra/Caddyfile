# Caddy reverse proxy for the Remote Support production deployment.
#
# One domain fronts everything, so the console and API share an origin (no CORS
# headaches) and WebSocket signaling rides the same TLS cert:
#   https://DOMAIN/            → web console
#   https://DOMAIN/api/*       → Go backend REST API
#   wss://DOMAIN/ws/*          → Go backend signaling (WebSocket upgrade)
#   https://DOMAIN/healthz,/readyz → backend health
#
# Caddy obtains and renews a Let's Encrypt certificate automatically as long as
# DOMAIN's DNS points at this host and ports 80 + 443 are reachable.

{
	# ACME account email (optional but recommended for expiry notices).
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Backend: REST API, WebSocket signaling, and health endpoints.
	@backend path /api/* /ws/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}

	# Everything else: the Next.js console.
	handle {
		reverse_proxy console:3000
	}
}

# ---------------------------------------------------------------------------
# Host onboarding — connect.DOMAIN
#
# Where an end user goes to join a session: they enter the 9-digit code the
# technician gave them and the page hands back the agent binary, named so it
# auto-configures itself and joins on launch (no terminal, no typing URLs).
#
# The REST API + WebSocket signaling are proxied here as well, so every request
# the end user's machine makes hits this single, freshly-provisioned host —
# which also side-steps any stale DNS cached for the apex domain.
# ---------------------------------------------------------------------------
connect.{$DOMAIN} {
	encode gzip

	# Backend REST + signaling (the downloaded agent talks to us directly).
	@backend path /api/* /ws/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}

	# One-click download. The response is the generic agent binary named
	# RemoteSupport--<host>--<code>.exe, so the agent reads the server + code
	# out of its own file name and joins on launch. The landing page only ever
	# requests a 9-digit code; a malformed name simply makes the agent fall back
	# to prompting, so this degrades safely.
	@dl path /dl
	handle @dl {
		root * /srv/agent
		header Content-Disposition `attachment; filename="RemoteSupport--{host}--{query.code}.exe"`
		header Content-Type application/octet-stream
		rewrite * /remote-agent.exe
		file_server
	}

	# Everything else: the static "enter your code" landing page.
	handle {
		root * /srv/connect
		file_server
	}
}
