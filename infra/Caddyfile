# Caddy reverse proxy for the Remote Support production deployment.
#
# Multi-tenant routing (all served by one console + one backend):
#   {$DOMAIN}, www           → apex (marketing / login)
#   admin.{$DOMAIN}          → platform super-admin panel
#   <username>.{$DOMAIN}     → per-technician tenant panel  (wildcard, on-demand TLS)
#   connect.{$DOMAIN}        → host onboarding (enter code → download client)
#
# The console (Next.js) renders the right panel from the Host header; /api, /ws
# and health always go to the Go backend. Certificates: fixed hostnames use
# HTTP-01; tenant subdomains are issued on demand, gated by the backend's
# /internal/tls-check so only real tenants (and the fixed names) get a cert.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:8080/internal/tls-check
	}
}

# Shared app routing: API/WS/health to backend, everything else to the console.
(app_routes) {
	encode gzip
	@backend path /api/* /ws/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy console:3000
	}
}

# Apex + www: marketing / login.
{$DOMAIN}, www.{$DOMAIN} {
	import app_routes
}

# Platform super-admin panel.
admin.{$DOMAIN} {
	import app_routes
}

# ---------------------------------------------------------------------------
# Host onboarding — connect.DOMAIN
# End user enters the 9-digit code and downloads the client, named so it
# auto-configures itself and joins on launch.
# ---------------------------------------------------------------------------
connect.{$DOMAIN} {
	encode gzip

	@backend path /api/* /ws/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}

	@dl path /dl
	handle @dl {
		root * /srv/agent
		header Content-Disposition `attachment; filename="RemoteSupport--{host}--{query.code}.exe"`
		header Content-Type application/octet-stream
		rewrite * /remote-agent.exe
		file_server
	}

	handle {
		root * /srv/connect
		file_server
	}
}

# ---------------------------------------------------------------------------
# Technician tenant panels — <username>.DOMAIN
# One wildcard block serves every technician's subdomain. Certificates are
# issued on demand per hostname and gated by the backend, so an attacker cannot
# flood the CA with requests for non-existent subdomains.
# ---------------------------------------------------------------------------
*.{$DOMAIN} {
	tls {
		on_demand
	}
	import app_routes
}
