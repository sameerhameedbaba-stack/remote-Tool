# Caddy reverse proxy for the Remote Support production deployment.
#
# Multi-tenant routing (all served by one console + one backend):
#   {$DOMAIN}, www, admin    → fixed hostnames (marketing/login, admin panel)
#   <username>.{$DOMAIN}     → per-technician tenant panel  (on-demand TLS)
#   connect.{$DOMAIN}        → host onboarding (enter code → download client)
#
# TLS: fixed hostnames get normal per-name certificates (HTTP-01). Tenant
# subdomains are dynamic, so they use a catch-all with ON-DEMAND TLS — Caddy
# issues an individual certificate per hostname on first request, gated by the
# backend's /internal/tls-check so only real tenants (+ fixed names) get one.
#
# NOTE: we deliberately do NOT use a "*.{$DOMAIN}" site label — that makes Caddy
# attempt a single wildcard certificate, which requires the DNS-01 challenge (a
# DNS-provider API credential). The catch-all below issues normal per-name certs
# via HTTP-01 instead, so no DNS API is needed.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:8080/internal/tls-check
	}
}

# Shared app routing: API/WS/health to backend, everything else to the console.
(app_routes) {
	encode gzip
	@backend path /api/* /ws/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy console:3000
	}
}

# Apex + www: the platform console, PLUS the customer code-entry page at /join
# so end users go to tiefixy.com/join (not a separate subdomain) to get the
# branded client. The download itself is /api/v1/connect/download (validates the
# code, serves the right technician's client) and is handled by app_routes.
{$DOMAIN}, www.{$DOMAIN} {
	@join path /join /join/
	handle @join {
		root * /srv/connect
		rewrite * /index.html
		file_server
	}
	import app_routes
}

# Admin panel — console only.
admin.{$DOMAIN} {
	import app_routes
}

# ---------------------------------------------------------------------------
# Host onboarding — connect.DOMAIN
# End user enters the 9-digit code and downloads the client, named so it
# auto-configures itself and joins on launch.
# ---------------------------------------------------------------------------
connect.{$DOMAIN} {
	encode gzip

	# API (incl. the validated /api/v1/connect/download) goes to the backend.
	@backend path /api/* /ws/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:8080
	}

	# The code-entry page. The download is now the code-validated backend
	# endpoint (see the page's script), not a raw static file, so there is no
	# unauthenticated /dl route any more.
	handle {
		root * /srv/connect
		file_server
	}
}

# ---------------------------------------------------------------------------
# Technician tenant panels — <username>.DOMAIN (and any other host)
# Catch-all with on-demand TLS: a per-hostname certificate is issued on the
# first request, but only after the backend's ask endpoint approves the name,
# so an attacker cannot flood the CA with certs for non-existent subdomains.
# Explicit blocks above take precedence, so this only ever handles tenant
# subdomains.
# ---------------------------------------------------------------------------
https:// {
	tls {
		on_demand
	}
	import app_routes
}
