# ---------------------------------------------------------------------------
# Remote Support — PRODUCTION environment.
# Copy to infra/.env and fill in REAL values. Never commit the real file.
#
# Strict mode is ON in production: the backend REFUSES to start if any secret
# still contains "change-me". Generate strong random secrets:
#   openssl rand -hex 32     # for JWT_SECRET / tokens / passwords
# ---------------------------------------------------------------------------

# --- Your domain + host ---
# DNS: point an A record for DOMAIN at PUBLIC_IP before starting.
DOMAIN=support.example.com
# This host's PUBLIC IP (coturn advertises it for WebRTC relay candidates).
PUBLIC_IP=203.0.113.10
# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_USER=remote
POSTGRES_PASSWORD=REPLACE-with-openssl-rand-hex-32
POSTGRES_DB=remote_support

# --- Backend secrets ---
# >= 32 bytes. openssl rand -hex 32
JWT_SECRET=REPLACE-with-openssl-rand-hex-32-min-32-bytes
JWT_TTL=3600s
# Shared token an operator gives an agent/installer to enroll a device.
AGENT_ENROLLMENT_TOKEN=REPLACE-with-openssl-rand-hex-32
SESSION_CODE_TTL=300s
SESSION_CODE_LENGTH=9

# Seed technician created on first boot (your console login). Leave blank to
# disable and create technicians another way.
SEED_TECH_EMAIL=admin@example.com
SEED_TECH_PASSWORD=REPLACE-with-a-strong-password

# --- TURN / STUN (coturn) ---
TURN_REALM=support.example.com
TURN_USER=turnuser
TURN_PASSWORD=REPLACE-with-openssl-rand-hex-32
# Advanced: override the ICE list the backend hands to peers. By default it is
# derived as ["stun:DOMAIN:3478","turn:DOMAIN:3478"], which is what you want.
# ICE_SERVERS=["stun:support.example.com:3478","turn:support.example.com:3478"]

# NOTE: APP_ENV is intentionally NOT set here — leaving it unset keeps the
# backend in STRICT secret-validation mode. Do not set APP_ENV=dev in prod.
